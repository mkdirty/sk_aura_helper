{
  "name": "sk-aura-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic data extraction and player navigation tools for Star Knightess Aura.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/vendor.mjs install",
    "vendor:check": "node scripts/vendor.mjs check",
    "runtime:detect": "node scripts/vendor.mjs detect",
    "game": "./game/Game",
    "harness": "tsx src/cli/harness.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "print": "tsx src/cli/print.ts",
    "where": "tsx src/cli/where.ts",
    "index": "tsx src/cli/index.ts",
    "crosscheck": "tsx src/cli/crosscheck.ts",
    "plugins": "tsx src/cli/plugins.ts",
    "cfg": "tsx src/cli/cfg.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5"
  }
}
